{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ordo/domain": ["../domain/src"],
      "@ordo/domain/identity": ["../domain/src/identity/index.ts"],
      "@ordo/domain/academic": ["../domain/src/academic/index.ts"],
      "@ordo/domain/resources": ["../domain/src/resources/index.ts"],
      "@ordo/domain/scheduling": ["../domain/src/scheduling/index.ts"],
      "@ordo/domain/publication": ["../domain/src/publication/index.ts"],
      "@ordo/domain/import-export": ["../domain/src/import-export/index.ts"],
      "@ordo/domain/analytics": ["../domain/src/analytics/index.ts"],
      "@ordo/domain/audit": ["../domain/src/audit/index.ts"],
      "@ordo/application": ["../application/src"],
      "@ordo/application/identity": ["../application/src/identity/index.ts"],
      "@ordo/application/academic": ["../application/src/academic/index.ts"],
      "@ordo/application/resources": ["../application/src/resources/index.ts"],
      "@ordo/application/scheduling": ["../application/src/scheduling/index.ts"],
      "@ordo/application/publication": ["../application/src/publication/index.ts"],
      "@ordo/application/import-export": ["../application/src/import-export/index.ts"],
      "@ordo/application/analytics": ["../application/src/analytics/index.ts"],
      "@ordo/application/audit": ["../application/src/audit/index.ts"],
      "@ordo/infrastructure": ["../infrastructure/src"],
      "@ordo/ui": ["../ui/src"],
      "@ordo/types": ["../types/src"],
      "@ordo/config": ["."],
      "@ordo/config/tsconfig.base.json": ["./tsconfig.base.json"],
      "@ordo/config/tsconfig.node.json": ["./tsconfig.node.json"],
      "@ordo/config/tsconfig.react.json": ["./tsconfig.react.json"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist", "apps", "supabase", "../../../supabase"]
}