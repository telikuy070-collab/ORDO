      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    },
    "./tailwind.config": {
      "default": "./tailwind.config.js"
    }
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ordo/types": "workspace:*"
  },
  "devDependencies": {
    "@ordo/config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
